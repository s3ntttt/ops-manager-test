# ─────────────────────────────────────────────
# OPS MANAGER – Environment Variable Template
# Copy this to .env and fill in your real values
# ─────────────────────────────────────────────

# One passcode per person:  NAME:CODE:MODE  separated by ";"  (MODE = edit or view, default edit)
# Codes must not contain ":" or ";".  Example: WILSENT:abc123:edit;AMIR:xyz789:view
USER_CODES=WILSENT:change_me:edit;GUEST:change_me_too:view
# Optional: old shared team code (logs in as TEAM, edit). Remove once everyone has their own code.
ACCESS_CODE=
JWT_SECRET=some_long_random_secret_string
GOOGLE_SHEETS_API_KEY=AIza...
FIREBASE_API_KEY=AIza...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_PROJECT_ID=your-project-id
PORT=3000

# Sheet watcher (optional) – the server re-reads the roster sheet by itself and logs headcount changes
# even when nobody has the app open. Uses the Firebase/Google keys above.
# WATCH_GROUPS=C,D          # shift groups to watch, comma separated
# WATCH_INTERVAL_MIN=5
# WATCH_TZ=Asia/Kuala_Lumpur
# WATCH_DISABLED=1          # set to turn it off
